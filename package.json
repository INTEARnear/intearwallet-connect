{
    "name": "intearwallet-connect",
    "version": "1.0.0",
    "description": "A lightweight connector library for Intear Wallet integration",
    "main": "build/index.js",
    "types": "build/index.d.ts",
    "files": [
        "build"
    ],
    "scripts": {
        "build": "npm run build:normal && npm run build:nearconnect",
        "build:normal": "rollup -c --environment BUILD_TARGET:normal",
        "build:nearconnect": "rollup -c --environment BUILD_TARGET:nearconnect",
        "build:types": "tsc --emitDeclarationOnly",
        "prepublishOnly": "npm run build",
        "example": "npm run build && node -e \"require('fs').writeFileSync('examples/index.js', require('fs').readFileSync('build/index.js'))\" && npx serve examples"
    },
    "devDependencies": {
        "@rollup/plugin-replace": "6.0.3",
        "@rollup/plugin-typescript": "12.3.0",
        "rollup": "4.59.0",
        "serve": "14.2.5",
        "tslib": "2.8.1",
        "typescript": "5.9.3"
    },
    "keywords": [
        "intear",
        "wallet",
        "connector",
        "blockchain",
        "web3"
    ],
    "author": "",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/INTEARnear/intearwallet-connect"
    },
    "bugs": {
        "url": "https://github.com/INTEARnear/intearwallet-connect/issues"
    },
    "homepage": ""
}
